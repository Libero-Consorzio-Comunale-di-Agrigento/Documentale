<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>
<?link rel="stylesheet" type="text/css" href="/css/protocollo.css"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('it.finmatica.commons.PopupSceltaUnitaViewModel')" border="normal"
            width="800px" height="95%"  sizable="true">

        <vlayout width="100%" vflex="1" spacing="10px">
            <h:div class="barraTitoloPagina">
                <label sclass="titoloPagina" value="Unità"/>
            </h:div>
            <grid sclass="form">
                <rows>
                    <row>
                        <cell colspan="2">
                            <textbox value="@bind(vm.filtroRicerca)" onOK="@command('onCerca')" hflex="1" mold="rounded" placeholder="Cerca unità..." focus="true"/>
                        </cell>
                    </row>
                </rows>
            </grid>

            <hlayout vflex="1">
                <tree model="@load(vm.alberoSo4)" hflex="1" vflex="1" selectedItem="@bind(vm.unitaSelezionataNodo)">
                    <treecols>
                        <treecol label="Struttura Organizzativa"/>
                    </treecols>
                    <template name="model">
                        <treeitem open="@load((each.livello lt vm.livelloApertura))"
                                  image="@load(c:cat(vm.urlIcone, 'unita_con_componenti_abilitati.png'))"
                                  draggable="@load(vm.isAbilitato(each))">
                            <treerow>
                                <treecell label="@load(each.denominazione)"  onDoubleClick="@command('onSelezionaUnita')" />
                            </treerow>
                        </treeitem>
                    </template>
                </tree>


            </hlayout>

            <h:div class="barraPulsanti">
                <h:div>
                    <button id="unita" mold="trendy" image="/images/afc/16x16/ok.png"    label="@load(vm.labelOperazione)" onClick="@command('onSelezionaUnita')" disabled="@load(empty vm.unitaSelezionataNodo)" />
                    <button mold="trendy" image="/images/afc/16x16/close.png" label="Chiudi" onClick="@command('onAnnulla')"/>
                </h:div>
            </h:div>
        </vlayout>
    </window>
</zk>