<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

    <window apply="org.zkoss.bind.BindComposer"
        viewModel="@id('vm') @init('it.finmatica.gestionedocumenti.dizionari.TipoAllegatoListaViewModel')" vflex="1" width="100%">

		<controlBarGridExcel/>

        <listbox model="@load(vm.listaTipoAllegato)" selectedItem="@bind(vm.selectedRecord)" emptyMessage="Nessun Tipo Allegato presente." vflex="1">
	        <listhead>
	        	<listheader label="Acronimo" />
	        	<listheader label="Descrizione" />
				<listheader label="Commento" />
				<listheader label="Valido" />
	        </listhead>
        	<template name="model" var="tipoAllegato">
	        	<listitem onDoubleClick="@command('onModifica', isNuovoRecord=false)">
	        		<listcell label="@load(tipoAllegato.acronimo)"/>
	        		<listcell label="@load(tipoAllegato.descrizione)"/>
					<listcell label="@load(tipoAllegato.commento)"/>
	                <listcell image="@load(tipoAllegato.valido  ? '/images/ags/16x16/point_green.png' : '/images/ags/16x16/point_red.png')" />
        		</listitem>
        	</template>
        </listbox>
		<hlayout>
			<PaginatedListFooter totalSize="@load(vm.totalSize)"
								 pageSizeOpzioni="@bind(vm.pageSizeOpzioni)"
								 pageSize="@bind(vm.pageSize)"
								 commandQueue="@load(vm.defaultCommandQueue)"/>
		</hlayout>

    </window>
</zk>