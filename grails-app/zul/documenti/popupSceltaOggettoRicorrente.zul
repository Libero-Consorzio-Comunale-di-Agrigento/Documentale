<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<!-- TODO[SPRINGBOOT]: spostare questo file in Protocollo e non GestioneDocumenti -->
<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

  <window apply="org.zkoss.bind.BindComposer"
        viewModel="@id('vm') @init('commons.PopupSceltaOggettoRicorrenteViewModel')"
        border="normal"
        title="Seleziona un oggetto tra quelli preconfigurati"
        closable="true"
        width="500px"
        height="500px">

		<listbox vflex="1" model="@load(vm.listaOggettiRicorrenti)"
			selectedItem="@bind(vm.selectedRecord)"
			emptyMessage="Nessun oggetto disponibile">
			<listhead>
				<listheader label="Oggetto" />
			</listhead>
			<template name="model" var="s">
				<listitem>
					<listcell label="@load(s.oggetto)" />
				</listitem>
			</template>
		</listbox>

		<h:div sclass="barraPulsanti">
			<h:div>
				<button
					disabled="@load(empty vm.selectedRecord)"
				 	mold="trendy"
					label="Seleziona"
					onClick="@command('onSelezionaOggettoRicorrente')" image="/images/afc/16x16/ok.png"/>
				<button
				 	mold="trendy"
					label="Chiudi"
					onClick="@command('onAnnulla')"  image="/images/afc/16x16/close.png" />
			</h:div>
		</h:div>
    </window>
</zk>