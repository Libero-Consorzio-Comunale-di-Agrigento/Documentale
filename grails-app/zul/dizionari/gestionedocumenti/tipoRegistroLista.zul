<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
    xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer"
       viewModel="@id('vm') @init('it.finmatica.gestionedocumenti.dizionari.TipoRegistroListaViewModel')" vflex="1" width="100%">

		<controlBarGridExcel/>

		<listbox model="@load(vm.listaTipoRegistroDto)" selectedItem="@bind(vm.selectedRecord)" emptyMessage="Nessun Tipo Registro presente." vflex="1">
	        <listhead>
	        	<listheader label="Codice" width="20%" />
	        	<listheader label="Descrizione" width="80%" />
	        	<listheader label="Rinnovo" width="60px" />
	        	<listheader label="Chiusura" width="60px" />
	        	<listheader label="" width="30px"/>
	        </listhead>
        	<template name="model" var="tipoRegistro">
	        	<listitem onDoubleClick="@command('onModifica', isNuovoRecord=false)">
	        		<listcell label="@load(tipoRegistro.codice)"/>
	        		<listcell label="@load(tipoRegistro.commento)"/>
	        		<listcell label="@load(tipoRegistro.rinnovoAutomatico? 'Si' : 'No')" style="text-align: center" />
	        		<listcell label="@load(tipoRegistro.chiusuraAutomatica? 'Si' : 'No')" style="text-align: center" />
	        		<listcell image="@load(tipoRegistro.valido  ? '/images/ags/16x16/point_green.png' : '/images/ags/16x16/point_red.png')" style="text-align: center" />
        		</listitem>
        	</template>
       	</listbox>
		<hlayout>
			<PaginatedListFooter totalSize="@load(vm.totalSize)"
								 pageSizeOpzioni="@bind(vm.pageSizeOpzioni)"
								 pageSize="@bind(vm.pageSize)"
								 commandQueue="@load(vm.defaultCommandQueue)"/>
		</hlayout>
    </window>
</zk>