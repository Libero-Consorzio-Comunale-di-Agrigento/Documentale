<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer" viewModel="@id('vm') @init('it.finmatica.gestionedocumenti.dizionari.NotificaListaViewModel')" width="100%" vflex="1">

		<controlBarGridExcel/>

		<listbox vflex="1" model="@load(vm.listaNotifica)" selectedItem="@bind(vm.selectedRecord)" emptyMessage="Nessuna notifica presente">
			<listhead>
				<listheader label="Tipologia" width="35%"/>
				<listheader label="Titolo" 	width="25%"/>
				<listheader label="Modalità" width="7%" 	/>
				<listheader label="Tipologia Scrivania" width="20%"/>
				<listheader label="Valida per i documenti" width="15%"/>
				<listheader width="30px"/>
			</listhead>
			<template name="model" var="notifica">
				<listitem onDoubleClick="@command('onModifica', isNuovoRecord=false)">
	                <listcell label="@load(notifica.tipoNotifica)"/>
	                <listcell label="@load(notifica.titolo)"/>
					<listcell label="@load(notifica.modalitaInvio)"/>
					<listcell label="@load(notifica.tipoNotificaScrivania)"/>
	                <listcell label="@load(notifica.listaOggettiDescrizioni)"/>
	                <listcell image="@load(notifica.valido ? '/images/ags/16x16/point_green.png' : '/images/ags/16x16/point_red.png')" />
				</listitem>
			</template>
		</listbox>
		<hlayout>
			<PaginatedListFooter totalSize="@load(vm.totalSize)"
								 pageSizeOpzioni="@bind(vm.pageSizeOpzioni)"
								 pageSize="@bind(vm.pageSize)"
								 commandQueue="@load(vm.defaultCommandQueue)"/>
		</hlayout>
    </window>
</zk>