<?xml version="1.0" encoding="UTF-8"?><?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?><?link rel="stylesheet" type="text/css" href="/css/atti.css"?>

<zk xmlns="http://www.zkoss.org/2005/zul" xmlns:h="http://www.w3.org/1999/xhtml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer"
            viewModel="@id('vm') @init('it.finmatica.commons.PopupSceltaModelloTestoViewModel')" border="normal"
            sizable="false" width="60%" height="50%" title=" ">

				<h:div sclass="barraTitoloPagina">
  					<label class="titoloPagina" value="Selezionare Modello testo da aggiungere"/>
				</h:div>

				<grid sclass="form">
						<rows>
							<row>
								<cell>
									<h:span class="mandatoryLabel">*</h:span><label value="Codice"/>
								</cell>
								<cell colspan="3">
									<combobox id="codice" hflex="1" selectedItem="@bind(vm.modelloTestoAssoc.codice)" readonly="true">
										<comboitem label="FILE PRINCIPALE" value="FILE_PRINCIPALE" visible="@load(vm.modelloTestoObbligatorio)"/>
										<comboitem label="FILE FRONTESPIZIO" value="FILE_FRONTESPIZIO"/>
										<comboitem label="FILE RICEVUTA" value="FILE_RICEVUTA"/>
									</combobox>
								</cell>
							</row>
							<row>
								<cell>
								 	<label value="Predefinito:"/></cell>
							     <cell>
								     <radiogroup selectedIndex="@load(vm.modelloTestoAssoc.predefinito ? 0 : 1)"
                                                 selectedItem="@save(vm.modelloTestoAssoc.predefinito)">
									   <radio label="Sì" value="@load(true)"/>
									   <radio label="No" value="@load(false)"/>
								</radiogroup>
								 </cell>
							</row>
						</rows>
				</grid>

				<vlayout width="100%" vflex="1" spacing="10px">
					 <listbox model="@load(vm.listaModelliTesto)"
							  selectedItem="@bind(vm.selectedRecord)"
							  emptyMessage="Nessun modello testo presente." vflex="1">
						<listhead>
							<listheader label="Nome"/>
							<listheader label="Descrizione"/>
						</listhead>
						<template name="model" var="modelloTesto">
							<listitem onDoubleClick="@command('onSeleziona')">
								<listcell label="@load(modelloTesto.nome)"/>
								<listcell label="@load(modelloTesto.descrizione)"/>
							</listitem>
						</template>
					</listbox>
				</vlayout>

				<h:div sclass="barraPulsanti">
					<h:div>
						<button label="Seleziona" onClick="@command('onSeleziona')" mold="trendy"></button>
						<button label="Annulla" onClick="@command('onChiudi')" mold="trendy"></button>
					</h:div>
				</h:div>

	</window>
</zk>