<?xml version="1.0" encoding="UTF-8"?>
<?taglib uri="http://www.zkoss.org/dsp/web/core" prefix="c"?>

<zk xmlns="http://www.zkoss.org/2005/zul"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.zkoss.org/2005/zul http://www.zkoss.org/2005/zul/zul.xsd">

	<window apply="org.zkoss.bind.BindComposer"
			viewModel="@id('vm') @init('it.finmatica.gestionedocumenti.test.AlberoSo4ViewModel')"
			position="center,middle"
			mode="modal"
			closable="false"
			width="100%" height="100%">

        <textbox value="@bind(vm.filtroRicerca)" onOK="@command('onCerca')"/>
        <button label="Cerca" onClick="@command('onCerca')"/>

		<tree model="@load(vm.alberoSo4)" height="100%" width="100%" vflex="1">
            <template name="model">
                <treeitem open="@load((each.livello lt vm.livelloApertura))" image="@load(c:cat('/images/ags/16x16/', each.icona))">
                    <treerow>
                        <treecell label="@load(each.denominazione)" />
                        <treecell label="@load(each.caricato)" />
                        <treecell label="@load(each.unita)" />
                    </treerow>
                </treeitem>
            </template>
        </tree>
	</window>
</zk>